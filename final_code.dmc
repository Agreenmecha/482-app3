' Main_Popsicle_Pusher.dmc
' Popsicle stick insertion on a moving conveyor belt.
' Axis A (linear stage, follower) is geared to Axis C (conveyor belt, leader).
' DI 3: popsicle sensor     (rising edge = popsicle detected)
' DI 4: conveyor run status (HIGH = stopped, LOW = running) -- informational only
' DO 1: pusher actuator     (pulse for pushDwl ms = 1 second)
'
' Sequence:
'   1. Home Axis A -- jog to RLS (zero) then FLS (measure travel) then rest
'   2. Launch sensor thread -- poll DI 3 continuously for popsicle detections
'   3. Main loop (thread 0):
'       a. Queue non-empty -- peek at oldest entry, decide action via #CHKACT
'          actCode = 0 -- not yet in stage range (wait)
'          actCode = 1 -- past RLS or stage cannot keep up (discard)
'          actCode = 2 -- in range and reachable (dispatch)
'
' Gearing is engaged only during dispatch (move + 1 s push) then disabled.
' Stage returns to rest position after every push.
'
' Popsicle position formula (gearing converts C counts -> A counts):
'   tgtA    = sensOfsA + (_TPC_now - C_at_detect) * grRatio
'   moveCnt = tgtA - _TPA
' Popsicles travel FLS->RLS so _TPC decreases as belt runs.
' sensOfsA = stgTravA + snrFlsMM * cntPerMM  (sensor is past FLS, > stgTravA).
'
' Abandon logic: predicts popsicle position when push would complete using
'   trapezoidal/triangular IP move time + push dwell + measured belt velocity.
'   If projected final position < abrtCnt, popsicle is dequeued without insert.

CN 1
CEA = 0
CEC = 0

' =====================================================================
' KNOWN CONSTANTS  (do not change without updating physical setup)
' =====================================================================
stageCPR = 8192           ;' Axis A encoder counts per revolution
stageLFR = 1.0 / 16       ;' Axis A linear feed rate (rev/mm) -- 1 rev per 16 mm
cntPerMM = stageCPR * stageLFR  ;' = 512 counts/mm

grRatio = 7.675863064180501360671552605434  ;' Axis A:C gear ratio -- positive: A moves toward RLS as C decreases (belt runs)

diSens = 3                ;' digital input: popsicle optical sensor
DI_CONV = 4               ;' digital input: conveyor status (1=stopped 0=running)
doPush = 1                ;' digital output: pusher actuator

pushDwl  = 1000           ;' pusher ON time (ms)
queueCap = 12             ;' ring queue capacity -- max popsicles in flight

' =====================================================================
' PHYSICAL PARAMETERS  (tune per motor sizing / physical setup)
' =====================================================================

' --- Homing (Axis A) ---
hmgVel = 50               ;' homing jog speed (mm/s)
hmgAcc = 100              ;' homing ramp-up rate (mm/s^2)
hmgDec = 100              ;' homing ramp-down rate (mm/s^2)

' --- Rest position (where pusher waits when queue is empty) ---
restMM = 30               ;' offset back from FLS (mm) -- 0 = rest at FLS

' --- Repositioning (Axis A moves between positions) ---
moveVel = 2000            ;' stage travel speed (mm/s)
moveAcc = 5000            ;' stage acceleration (mm/s^2)
moveDec = 2000            ;' stage deceleration (mm/s^2)

' --- Sensor-to-pusher distance ---
' Pusher rests at FLS so this equals the sensor-to-FLS distance.
' Popsicles travel FLS->RLS so the sensor sits past FLS (positive value).
snrFlsMM = 325            ;' sensor is 325 mm from pusher / past FLS

' --- Dispatch position calibration offset ---
' Positive shifts dispatch toward FLS -- negative shifts toward RLS.
calOfsMM = 24.5           ;' trim offset (mm) -- start at 0 then dial in

' --- Abandon logic ---
' Minimum projected popsicle position (mm above RLS) at end of push.
' If predicted finalPos < abrtCnt, popsicle is dequeued without insertion.
abrtMM = 2

' =====================================================================
' UNIT CONVERSIONS  (all motion commands use integer counts)
' =====================================================================
hmgVelA  = @INT[hmgVel  * cntPerMM]
hmgAccA  = @INT[hmgAcc  * cntPerMM]
hmgDecA  = @INT[hmgDec  * cntPerMM]

moveVelA = @INT[moveVel * cntPerMM]
moveAccA = @INT[moveAcc * cntPerMM]
moveDecA = @INT[moveDec * cntPerMM]

restA    = @INT[restMM   * cntPerMM]
snrCnt   = @INT[snrFlsMM * cntPerMM]
calCnt   = @INT[calOfsMM * cntPerMM]
abrtCnt  = @INT[abrtMM   * cntPerMM]

' --- Trap-profile timing constants for abandon prediction ---
' Triangular vs trapezoidal IP move time, derived from SP/AC/DC:
'   tRamp = vMax/aA + vMax/aD             (full ramp-up + ramp-down time)
'   dRamp = vMax * tRamp / 2              (distance covered during full ramp)
'   d >= dRamp -> trap:  t = tRamp + (d - dRamp)/vMax
'   d <  dRamp -> tri :  t = tRamp * sqrt(d/dRamp)
pushSecs = pushDwl / 1000.0
trampSc  = (moveVelA / moveAccA) + (moveVelA / moveDecA)
dRamp    = @INT[moveVelA * trampSc / 2]

' stgTravA and sensOfsA are measured/derived at runtime during HOME_A.
' sensOfsA = stgTravA + snrCnt + calCnt  (sensor is snrCnt past FLS, plus trim).
stgTravA = 0
sensOfsA = 0

' =====================================================================
' RING QUEUE GLOBALS
' Stores _TPC snapshots (C encoder counts) at popsicle detection time.
' FIFO: fill/proc are monotonic indices -- length = fill - proc.
' DM array size must be a literal -- keep in sync with queueCap above.
' Thread safety: thread 1 (sensor) writes fill -- thread 0 (main) writes proc.
' Single-producer / single-consumer -- no locking needed.
' =====================================================================
DM buf[12]
n    = queueCap           ;' runtime capacity used by Q_PUSH / Q_POP
fill = 0                  ;' write index (monotonic)
proc = 0                  ;' read index  (monotonic)

' Dispatch workspace (written by #CHKACT, read by main loop / DSPATCH)
nextTgtA = 0              ;' computed target A position for next popsicle (counts)
nxtMovCt = 0              ;' computed IP delta for next popsicle (counts)
abandon  = 0              ;' 1 = stage cannot keep up before push completes
actCode  = 0              ;' 0=wait, 1=discard, 2=dispatch

' =====================================================================
' INITIALIZATION
' =====================================================================
ST A
AM A
MO A
DP 0       ;' zero Axis A encoder
DPC = 0    ;' zero Axis C encoder (conveyor belt master)
SH A
KPA = 50
KDA = 100
KIA = 0.05
AC hmgAccA
DC hmgDecA

' =====================================================================
' STEP 1: HOME AXIS A
' =====================================================================
JS #HOME_A
sensOfsA = stgTravA + snrCnt + calCnt

' =====================================================================
' STEP 2: SET TRAP PARAMS and launch sensor thread
' Gearing is NOT engaged here -- it is engaged per-dispatch inside DSPATCH.
' =====================================================================
SPA = moveVelA
ACA = moveAccA
DCA = moveDecA

XQ #SNRLOOP, 1

' =====================================================================
' STEP 3: MAIN DISPATCH LOOP (thread 0)
' =====================================================================
#MAINLP
IF (fill <> proc)
    JS #CHKACT
    IF (actCode = 1)
        JS #Q_POP                              ;' past RLS or unreachable -- discard
    ENDIF
    IF (actCode = 2)
        JS #DSPATCH                            ;' in range -- dispatch
    ENDIF
    ' actCode = 0: not yet in stage range -- fall through and re-poll
ENDIF
JP #MAINLP

' =====================================================================
' SHUTDOWN  (unreachable from main loop -- invoke via XQ #SHTDOWN)
' =====================================================================
#SHTDOWN
MO A
EN

' =====================================================================
' SNRLOOP  (thread 1 -- runs concurrently with main dispatch loop)
' Rising edge on diSens: snapshot _TPC and enqueue.
' =====================================================================
#SNRLOOP
prevDI3 = @IN[diSens]     ;' seed state to avoid spurious trigger at start
#snrPoll
    curDI3 = @IN[diSens]
    IF ((curDI3 = 1) & (prevDI3 = 0))
        val = _TPC
        JS #Q_PUSH
    ENDIF
    prevDI3 = curDI3
    JP #snrPoll
EN

' =====================================================================
' HOME_A: jog to RLS (zero), jog to FLS (record travel), return to rest
' =====================================================================
#HOME_A
    SPA = hmgVelA         ;' set trap speed for PA return move at end

    ' --- Step 1: jog negative until RLS triggers ---
    JG -hmgVelA
    BG A
#hmgRLS
    JP #hmgRLS,(_LRA=1)
    ST A
    AM A
    WT 250
    DP 0                  ;' define RLS as position zero

    ' --- Step 2: jog positive until FLS triggers ---
    JG hmgVelA
    BG A
#hmgFLS
    JP #hmgFLS,(_LFA=1)
    ST A
    AM A
    WT 250
    stgTravA = _TPA       ;' record full travel range (counts from RLS to FLS)

    ' --- Step 3: move to rest position (restMM back from FLS) ---
    PAA = stgTravA - restA
    BG A
    AM A
EN

' =====================================================================
' CHKACT: peek queue head and classify the resulting action
' Outputs (all globals):
'   nextTgtA  -- popsicle position in A counts (current _TPC)
'   nxtMovCt  -- IP delta from current _TPA to nextTgtA (counts)
'   abandon   -- 1 if stage cannot keep up before push completes, else 0
'   actCode   -- 0 = wait (still past FLS / not in range)
'                1 = discard (past RLS or unreachable)
'                2 = dispatch (in range and reachable)
'
' Abandon model: predict popsicle position at end of push, given
'   tCatch (IP-move time, trap or triangular) + pushSecs (dwell).
'   Uses _TVC to measure belt velocity in real time -- works at any
'   conveyor speed without recalibration.  Belt running implies _TVC < 0.
' =====================================================================
#CHKACT
    JS #Q_PEEK
    nextTgtA = sensOfsA + ((_TPC - ret) * grRatio)
    nxtMovCt = @INT[nextTgtA - _TPA]

    abandon = 0
    IF (_TVC < 0)
        distMov = @ABS[nxtMovCt]
        IF (distMov >= dRamp)
            tCatch = trampSc + (distMov - dRamp) / moveVelA
        ELSE
            tCatch = trampSc * @SQR[distMov / dRamp]
        ENDIF
        finalPs = nextTgtA + (_TVC * grRatio) * (tCatch + pushSecs)
        IF (finalPs < abrtCnt)
            abandon = 1
        ENDIF
    ENDIF

    actCode = 0
    IF (nextTgtA < 0)
        actCode = 1                            ;' already past RLS
    ELSE
        IF (nextTgtA <= stgTravA)
            actCode = 2                        ;' in range
            IF (abandon = 1)
                actCode = 1                    ;' but cannot keep up -- abandon
            ENDIF
        ENDIF
    ENDIF
EN

' =====================================================================
' DISPATCH: engage gearing, move to popsicle, push, disengage, return to rest
' Sensor thread (thread 1) keeps polling throughout.
' #CHKACT is re-run before every IP move so abandon detection stays current
' even for back-to-back popsicles processed without returning to rest.
' =====================================================================
#DSPATCH
    GA C
    GRA = grRatio                              ;' engage gearing for this chain

#dspLp
    SPA = moveVelA                             ;' restored on every loop entry
    JS #CHKACT
    JP #chkNxt,(actCode = 0)                   ;' (rare) drifted out of range
    IF (actCode = 1)
        JS #Q_POP                              ;' abandon or past RLS
        JP #chkNxt
    ENDIF
    ' actCode = 2: dispatch
    IP A=nxtMovCt                              ;' relative move superimposed on gearing
    AM A
    SB doPush                                  ;' gearing keeps stage on popsicle during push
    WT pushDwl
    CB doPush
    JS #Q_POP                                  ;' stick inserted -- dequeue

#chkNxt
    doLoop = 0
    IF (fill <> proc)
        JS #CHKACT
        IF (actCode = 1)
            JS #Q_POP
            doLoop = 1                         ;' queue changed -- recheck
        ENDIF
        IF (actCode = 2)
            doLoop = 2                         ;' dispatch immediately
        ENDIF
    ENDIF
    JP #dspLp,(doLoop = 2)
    JP #chkNxt,(doLoop = 1)

    ' Queue empty or next popsicle not yet in range -- return to rest
    GRA = 0
    PAA = stgTravA - restA
    BG A

#retLp
    doLoop = 0
    IF (fill <> proc)
        JS #CHKACT
        IF (actCode = 1)
            JS #Q_POP                          ;' discard without stopping motion
            doLoop = 2                         ;' recheck queue
        ENDIF
        IF (actCode = 2)
            doLoop = 1                         ;' intercept -- stop and re-engage
        ENDIF
    ENDIF
    JP #gotIt,(doLoop = 1)
    JP #retLp,(doLoop = 2)
    JP #retLp,(_BGA = 1)                       ;' still moving -- keep polling
EN                                             ;' return move complete

#gotIt
    ST A
    AM A
    GA C
    GRA = grRatio                              ;' re-engage gearing at current position
    JP #dspLp                                  ;' dispatch intercepted popsicle

' =====================================================================
' RING QUEUE SUBROUTINES
' =====================================================================
#Q_PUSH               ;' input:  val  (_TPC snapshot to enqueue) -- thread 1
    widx = (fill % n)
    buf[widx] = val
    fill = fill + 1
EN

#Q_POP                ;' output: ret  (oldest _TPC value -- removes) -- thread 0
    ridx = (proc % n)
    ret = buf[ridx]
    proc = proc + 1
EN

#Q_PEEK               ;' output: ret  (oldest _TPC value -- no remove) -- thread 0
    ridx = (proc % n)
    ret = buf[ridx]
EN
